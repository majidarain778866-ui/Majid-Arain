# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (Only needed if running full-stack Node server)
# ==============================================================================

# GEMINI_API_KEY: Optional server-side Gemini AI generation key.
# If omitted, the application runs its deterministic fallback strategy engine.
GEMINI_API_KEY=""

# PORT: Server listening port (default: 3000)
PORT=3000

# ==============================================================================
# NETLIFY & CLIENT-SIDE PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# VITE_SITE_URL: Canonical base URL for production deployment (e.g. https://your-site.netlify.app)
VITE_SITE_URL="https://your-site.netlify.app"

# Firebase Authentication & Google Workspace Gmail Client Config
# Note: Defaults are already safely bundled via firebase-applet-config.json.
# Set these in the Netlify Dashboard under Site Configuration > Environment variables
# if you wish to override with your own Firebase project credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

